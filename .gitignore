# eclipse
bin
*.launch
.settings
.metadata
.classpath
.project

# idea
out
*.ipr
*.iws
*.iml
# Mica fork: `.idea/*` rather than `.idea`, because git cannot descend into an excluded
# directory and the negations below would never be reached.
#
# Only the shared, numbered run configurations are versioned -- they are portable Gradle
# configs that reference nothing but $PROJECT_DIR$ and a task name. Everything else in
# .idea/runConfigurations/ stays local, which specifically covers the Application configs
# ForgeGradle's `genIntellijRuns` writes there (runClient.xml, runServer.xml, runData.xml):
# those embed absolute paths into ~/.gradle and the checkout, so committing them would both
# break other machines and leak the local username.
.idea/*
!.idea/runConfigurations/
.idea/runConfigurations/*
!.idea/runConfigurations/[0-9]__*.xml

# gradle
build
.gradle

# other
eclipse
run

# Files from Forge MDK
forge*changelog.txt
*.log
.cache/
.DS_Store

# ---------------------------------------------------------------------------
# Mica Technologies fork additions
# Everything above this line is inherited from upstream (Theatrical), apart from the
# annotated .idea block. Keep fork-specific entries below so the upstream diff stays
# readable.
# ---------------------------------------------------------------------------

# Windows / OS cruft
Thumbs.db
thumbs.db
desktop.ini

# JVM crash logs and Minecraft runtime output
hs_err_pid*
crash-reports/
logs/
run-server/

# Gradle/Java leftovers
tmp/
*.tmp
*.bak
*.swp
local.properties
.factorypath

# Local-only Claude Code state. Shared settings (.claude/settings.json) ARE committed;
# per-machine overrides and agent worktrees are not.
.claude/settings.local.json
.claude/worktrees/

# Agent working notes and implementation plans. Local scratch by design -- these churn
# constantly and are written for whoever/whatever is doing the work right now, not for
# the repo's history. Both spellings are listed because gitignore matching is
# case-sensitive on Linux CI even though Windows/macOS checkouts usually are not.
docs/agent-plans/
docs/AGENT-PLANS/

# Printable checklists generated for a play-test session.
*-test-plan.pdf

# Secrets
*.env
.env.*
*credentials*
